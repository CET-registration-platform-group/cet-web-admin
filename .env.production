# 环境
NODE_ENV=production

# API 配置
VITE_API_BASE_URL=http://121.43.66.230:8090
VITE_API_TIMEOUT=10000
VITE_API_RETRY=3
VITE_API_RETRY_DELAY=1000


# 应用配置
VITE_APP_TITLE=停车场管理系统
VITE_APP_ENV=production
VITE_APP_BASE_URL=/

# 功能开关
VITE_USE_MOCK=false
VITE_USE_DEVTOOLS=false
VITE_USE_DYNAMIC_ROUTES=true
VITE_USE_ROLES=true


# 主题配置
VITE_THEME_PRIMARY_COLOR=#409EFF
VITE_THEME_DARK_MODE=false

# 缓存配置
VITE_STORAGE_PREFIX=parking_prod_
VITE_STORAGE_EXPIRE=2592000000
